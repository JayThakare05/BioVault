# Backend server
PORT=5000

# Comma-separated allowed origins (example)
CORS_ORIGIN=http://localhost:5173,https://your-ngrok-domain.ngrok-free.app

# MongoDB
MONGO_URI=mongodb://localhost:27017/biovault

# AES secret used for private key encryption (use a long random value)
SECRET_KEY=replace_with_a_long_random_secret

# AI service endpoint
AI_SERVICE_URL=http://localhost:8000/ai/process
